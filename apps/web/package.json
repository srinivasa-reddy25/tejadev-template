{
  "name": "@tejadev/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js web app for TejaDev monorepo template",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev",
    "build": "dotenv -e ../../.env -- next build",
    "build:docker": "next build",
    "start": "dotenv -e ../../.env -- next start",
    "start:docker": "next start -p 3000",
    "clean": "rm -rf .next",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tejadev/shared": "0.0.0",
    "next": "^15.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tejadev/eslint-config": "workspace:*",
    "@tejadev/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
