{
  "name": "@tejadev/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express API app for TejaDev monorepo template",
  "scripts": {
    "dev": "dotenv -e ../../.env -- bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap",
    "start": "dotenv -e ../../.env -- bun src/index.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tejadev/shared": "0.0.0",
    "cors": "^2.8.5",
    "express-async-errors": "^3.1.1",
    "express-fileupload": "^1.5.2",
    "express": "^4.21.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@tejadev/eslint-config": "workspace:*",
    "@tejadev/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2"
  }
}
